local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local LocalPlayer = Players.LocalPlayer

pcall(function()
    if CoreGui:FindFirstChild("AstroLoaderGui") then CoreGui.AstroLoaderGui:Destroy() end
    if CoreGui:FindFirstChild("AstroUltimateGui") then CoreGui.AstroUltimateGui:Destroy() end
end)

local function playSound()
    pcall(function()
        local sd = Instance.new("Sound")
        sd.SoundId = "rbxassetid://6042457221"
        sd.Volume = 0.4
        sd.Parent = SoundService
        sd:Play()
        game:GetService("Debris"):AddItem(sd, 1)
    end)
end

